! Лабораторная №9.
! ============================================================
! Вариант: alpha=10 Вт/(м2*К), Ncool=20, K=5
! ============================================================

RESTART=0;
TITLE='VD.035.004 LAB9 FIN';
DT_MAX=0.001;
DT_OUT=5000.;
FIN_TIM=5000.;
DT_SAV=0.;

APPEND_RES=1;!Признак дополнения списка вывода, 
!запомненного в файле сохранения состояния задачи, 
!списком, формируемым процедурами OUTPUT файла входных данных для задачи типа RESTART 


! --- Геометрия и свойства ---
Ncool=20;              ! число охлаждаемых ячеек (2:N)
Ntot=Ncool+1;          ! всего ячеек HCS: 1 контактная + Ncool
Knodes=5;              ! число узлов по толщине

L=0.060;               ! высота охлаждаемой части, м
delta=0.002;           ! толщина ребра, м
b=0.100;               ! ширина ребра, м
lc=0.001;              ! длина контактной ячейки, м

lam=50.;               ! Вт/(м*К)
rho=7800.;             ! кг/м3
c=500.;                ! Дж/(кг*К)

T0=393.15;             ! 120 C
T1=293.15;             ! 20 C
alpha=3.;             ! Вт/(м2*К), для вариантов: 3, 5, 10, 20, 50

LAYOUT
!Процедура для задания связей между элементами
  ! Контактная ячейка 1: приближение основания T0
  HCS1(1)/1 - BHEAT1;
  HCS1(1)/2 - BHEAT1;

  ! Охлаждаемые ячейки 2:N: обе широкие поверхности, alpha и T1
  HCS1(2:Ntot)/1 - BHEAT2;
  HCS1(2:Ntot)/2 - BHEAT2;
END

!Вызовы процедур data (каждый call запускает процесс чтения данных своего data)
CALL HCS1;
CALL BHEAT1;
CALL BHEAT2;

OUT OUT1;

END

! ============================================================
! Теплопроводящая конструкция: плоское ребро, 2D
! ============================================================
DATA HCS1
  N=Ntot;! кол-во ячеек
  KL=1; !кол-во слоев
  K=Knodes; !кол-во ячеек по толщине
  TYPE=2;              ! двумерная теплопроводность
  COOR=0;              ! декартова (плоская) геометрия

  DFZ(1)=lc;
  DFZ(2:N)=L/Ncool;

  XL(1:2)=0., delta;
  X(1:K)=LINA(0., delta, K);

  LAM=lam;
  CR=rho*c;
  B=b;

  QX=0.;
  QZ=0.;
END

! ============================================================
! Контактная ячейка: T = T0 (1-й род)
! ============================================================
DATA BHEAT1
  TYPE=1;
  BCOND(1)=T0;
  BCOND(2)=0;
END

! ============================================================
! Охлаждаемые поверхности: alpha, T1 (3-й род)
! ============================================================
DATA BHEAT2
  TYPE=3;
  BCOND(1)=alpha;
  BCOND(2)=T1;
END

! ============================================================
! Вывод: средняя по толщине T, температуры поверхностей,
! коэффициенты теплоотдачи и температуры среды
! ============================================================
OUTPUT OUT1
  WRITE TAV.HCS1(1,1:Ntot);
  WRITE TW.HCS1(1,1:Ntot);
  WRITE TW.HCS1(2,1:Ntot);
  WRITE T.HCS1(3,1:Ntot);
  WRITE ALW.HCS1(1,1:Ntot);
  WRITE ALW.HCS1(2,1:Ntot);
  WRITE TENV.HCS1(1,1:Ntot);
  WRITE TENV.HCS1(2,1:Ntot);
END